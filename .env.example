# sg-eqdp-scanner — environment variable template
# Copy to .env.local (Python) and to web/.env.local (Next.js).
# .env.local is gitignored. Never commit real values.

# Supabase — Postgres + Auth + Storage
# Find these at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE=<your-service-role-key-bypasses-RLS>

# Direct DB connection — pipelines/scripts that need raw SQL.
# Note: db.<ref>.supabase.co is IPv6-only on Supabase free tier.
# Use the IPv4 Session Pooler URL from Dashboard → Database → Connection Pooling
# if your network has no IPv6.
DB_DIRECT_CONNECTION=postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres

# Vercel revalidation — Python pipeline POSTs here after a daily run
REVALIDATE_URL=https://<vercel-deploy>.vercel.app/api/revalidate
REVALIDATE_TOKEN=<shared-secret-also-set-in-vercel>

# Resend — transactional email (magic links + filing blasts)
RESEND_API_KEY=<your-resend-key>
RESEND_FROM_EMAIL=brief@<your-verified-domain>

# Single admin — gates /admin/*. Don't hardcode this address anywhere else.
ADMIN_EMAIL=<admin-email-address>

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EQDP Brief
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — yfinance polite UA (only if rate-limited by Yahoo)
# YFINANCE_USER_AGENT=sg-eqdp-scanner/0.1 (+https://github.com/<user>/sg-eqdp-scanner)

# Optional — for /api/health or pipeline alerts
# ANTHROPIC_API_KEY=<for-future-use>
# DATALAB_API_KEY=<for-OCR-of-PDF-broker-notes>
