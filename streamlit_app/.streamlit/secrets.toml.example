# Copy to .streamlit/secrets.toml for local dev.
# On Streamlit Community Cloud, paste this content into the app's
# Settings → Secrets panel — do NOT commit secrets.toml to git.

SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key-here"

# Optional — only needed if the app writes (registration form, engagement events).
# Prefer the anon key + RLS policies; only fall back to service-role if absolutely required.
# SUPABASE_SERVICE_ROLE = "your-service-role-key-here"

# Admin contact (rendered in the disclaimer footer).
ADMIN_EMAIL = "palani@unisongroup.com"
